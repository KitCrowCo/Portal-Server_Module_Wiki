# --- Path / access helpers ---

def resolve_path(rel_path: str) -> pathlib.Path:
    base = WIKI_ROOT.resolve()
    if rel_path in (None, "", "."): return base
    p_in = pathlib.Path(rel_path)
    # p = p_in.resolve() if str(p_in).startswith(str(base)) else (base / str(p_in).replace("data/wiki/pages/", "").lstrip("/")).resolve()
    p = p_in.resolve() if str(p_in).startswith(str(base)) else (base / str(p_in).replace("data/_common/", "").lstrip("/")).resolve()
    if not str(p).startswith(str(base)): raise HTTPException(status_code=400, detail="Path outside WIKI_ROOT")
    return p

def _wiki_link(m: re.Match, base_dir: str = "") -> str:
    """[[path/page]] or [[path/page|Display]]. No extension in the written link means .md; an explicit extension is used exactly as written - [[notes.txt]] resolves to notes.txt, never notes.txt.md."""
    target, _, alias = m.group(1).partition("|")
    target, alias = target.strip(), alias.strip()
    if target.startswith("./") or target.startswith("../"):
        resolved = (Path(base_dir) / target).resolve() if base_dir else Path(target.lstrip("./"))
        try: target = str(resolved.relative_to(WIKI_ROOT.resolve())).replace("\\","/")
        except ValueError: pass
    has_ext = bool(Path(target).suffix)
    file_path = target if has_ext else f"{target}.md"
    display = alias or Path(target).name
    vals = json.dumps({"type": "wiki_nav_link", "path": file_path, "label": display, "id": f"wiki-{re.sub('[^a-z0-9]', '-', target.lower())[:24]}"})
    col = "var(--accent)" if (WIKI_ROOT / file_path).exists() else "#ffaa44"
    return f"""<a class="wiki-link" href="#" hx-post="/im/in" hx-vals='{vals}' hx-target="body" hx-swap="none" onclick="event.preventDefault()" style="color:{col};border-bottom:var(--border-thick) dotted {col};text-decoration:none" title="{UI.escape(file_path)}">{UI.escape(display)}</a>"""

def _wiki_embed(m: re.Match, base_dir: str = "") -> str:
    """[[file]] (block ![[...]] embed). './'/'../' resolve relative to the current document's folder."""
    target = m.group(1).strip()
    if target.startswith("./") or target.startswith("../"):
        resolved = (Path(base_dir) / target).resolve() if base_dir else Path(target.lstrip("./"))
        try: target = str(resolved.relative_to(WIKI_ROOT.resolve())).replace("\\","/")
        except ValueError: pass  # would escape WIKI_ROOT - leave target unchanged, link will 404 safely
    ext = Path(target).suffix.lower()
    url = f"{_P}/raw/{target}"
    if ext in (".png",".jpg",".jpeg",".gif",".webp",".svg"): return f'<img src="{url}" alt="{UI.escape(target)}" style="max-width:100%;border-radius:var(--radius);">'
    if ext in (".mp4",".webm",".ogg"): return f'<video src="{url}" controls style="max-width:100%;border-radius:var(--radius);"></video>'
    if ext == ".pdf": return f'<iframe src="{url}" style="width:100%;height:32rem;border:var(--border-thick) solid var(--border);border-radius:var(--radius);"></iframe>'
    return f'<a href="{url}" style="color:var(--accent)">&#x1F4CE; {UI.escape(target)}</a>'

def _wiki_tree_html(request: Request, active_path: str = "") -> str:
    wiki_only = (SM.get("file_mode") or "wiki_only") == "wiki_only"
    @lru_cache(maxsize=None)
    def _visible(rel):
        if not _can_view(request, rel): return False
        if wiki_only and not (WIKI_ROOT / rel).is_dir() and Path(rel).suffix.lower() != ".md": return False
        return True
    return UI.tree(items=resolve_path(""), rel_to=WIKI_ROOT, mode="file", active=active_path, options={"post": "/im/in", "target": "body", "swap": "none", "extra_vals": {"type": "wiki_nav_link", "label": ""}}, context_menu_url=f"{_P}/ctx_menu", visible_fn=_visible, label_fn=display_name)

# --- State ---

async def wiki_state(request: Request, state: dict = None) -> dict:
    if state is not None:
        await ENV["set_state"](request, state, scope="user", namespace="wiki")
        return state
    state = await ENV["get_state"](request, scope="user", namespace="wiki") or {}
    state.setdefault("tabs", {"home": {"id": "home", "path": "home.md", "label": "Home", "icon": "&#x1F3E0;", "order": 0}})
    state.setdefault("active", "home")
    return state

def _ensure_home_exists():
    home = WIKI_ROOT / "home.md"
    if not home.exists(): home.write_text("# Welcome to the Wiki\n\nThis is the home page. Edit it to get started.\n", encoding="utf-8")

# --- IM intent handlers (module-level, reference globals set by init_module) ---

async def _intent_wiki_link(request, payload, imr):
    rel = payload.get("path")
    if not rel: return imr
    try: p = resolve_path(rel)
    except Exception: return imr
    if not p.exists(): return imr
    mode = (SM.get("link_mode") or "same_tab") if SM else "same_tab"
    if mode == "same_tab":
        state = await wiki_state(request)
        active = state.get("active")
        if active and active in state["tabs"]:
            state["tabs"][active]["path"], state["tabs"][active]["label"] = rel, p.name
            await wiki_state(request, state)
            return await TM._push(request, state, imr)
    tid = f"wiki-{abs(hash(rel)) % 0xFFFFFF:06x}"   # always derived from the resolved path - never trust the caller's id, or tree-clicks and wikilink-clicks to the same page produce different tab ids
    return await TM._open(request, {"id": tid, "path": rel, "label": p.name, "icon": "&#x1F4C4;"}, imr)

# --- Access Control ---
# Global edit_roles/view_roles (settings) gate the whole wiki. Rules here narrow further per path-prefix or tag.
# No rule for a page -> falls through to the global role check only.

def _rules_path() -> Path: return DATA_DIR / "access_rules.json"
def _tags_path() -> Path: return DATA_DIR / "tags.json"
def _load_rules() -> list: return json.loads(_rules_path().read_text()) if _rules_path().exists() else []
def _save_rules(rules: list): _rules_path().write_text(json.dumps(rules, indent=2))
def _load_tags() -> dict: return json.loads(_tags_path().read_text()) if _tags_path().exists() else {}
def _save_tags(tags: dict): _tags_path().write_text(json.dumps(tags, indent=2))

def _matching_rules(rel_path: str, scope: str) -> list:
    tags = _load_tags().get(rel_path, [])
    out = []
    for r in _load_rules():
        if r.get("scope") != scope: continue
        if r["target_type"] == "path" and (rel_path == r["target"] or rel_path.startswith(r["target"].rstrip("/") + "/")): out.append(r)
        elif r["target_type"] == "tag" and r["target"] in tags: out.append(r)
    return out

def _rule_allows(rel_path: str, user, scope: str) -> bool:
    rules = _matching_rules(rel_path, scope)
    if not rules: return True
    subjects = {user.username, f"role:{user.role}"} if user else set()
    for r in rules:
        allowed = bool(set(r.get("subjects", [])) & subjects)
        if r["mode"] == "whitelist" and not allowed: return False
        if r["mode"] == "blacklist" and allowed: return False
    return True

def _can_edit(request: Request, rel_path: str = "") -> bool:
    role = getattr(request.state.user, "role", "user")
    if role == "admin": return True
    roles = [r.strip() for r in (SM.get("edit_roles") or "admin").split(",") if r.strip()] if SM else ["admin"]
    if role not in roles: return False
    return _rule_allows(rel_path, request.state.user, "edit") if rel_path else True

def _can_view(request: Request, rel_path: str = "") -> bool:
    role = getattr(request.state.user, "role", "user")
    if role == "admin": return True
    view_roles = [r.strip() for r in (SM.get("view_roles") or "").split(",") if r.strip()] if SM else []
    if view_roles and role not in view_roles: return False
    return _rule_allows(rel_path, request.state.user, "view") if rel_path else True

# --- Module Initialization ---

async def _wiki_get_tab(request, did):
    state = await wiki_state(request)
    tab = state.get("tabs", {}).get(did)
    return tab if tab and _can_view(request, tab.get("path","")) else None

def init_module(env: dict):
    global ENV, IM, TM, SM, DE, BI, UI, FM, WIKI_ROOT
    ENV.update(env)
    UI = ENV["templates"].env.globals.get("UI")
    BI = ENV["tools"]["built_ins"]
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    WIKI_ROOT.mkdir(parents=True, exist_ok=True)
    _ensure_home_exists()
    SM = BI.SettingsPanel("Wiki", [BI.SettingsGroup("defaults", "Settings", [
        BI.SettingField("title", "Wiki Title", "text", "Wiki"),
        BI.SettingField("edit_roles", "Edit Access (roles)", "text", "admin", hint="Comma-separated roles allowed to edit/create/delete. Empty = all."),
        BI.SettingField("view_roles", "View Access (roles)", "text", "", hint="Empty = all authenticated users."),
        BI.SettingField("file_mode", "File visibility", "select", "wiki_only", options=[("wiki_only","Markdown pages only"),("all_files","All files")]),
        BI.SettingField("link_mode", "Wiki-link navigation", "select", "same_tab", options=[("same_tab","Navigate the current tab"),("new_tab","Open each page in its own tab")]),
        BI.SettingField("loose_breaks", "Treat every Enter as a paragraph break", "checkbox", False, hint="Off (default): a single Enter is a soft line break, a blank line starts a new paragraph. On: every line gets full paragraph spacing."),
    ], json_path=str(DATA_DIR / "settings.json"))])
    IM = ENV["InterfaceManager"](nesting_level=1, db_path="wiki_im.db")
    TM = BI.TabManager(namespace="wiki", tab_bar_id="wiki-tab-bar", content_id="wiki-workspace", render_content_fn=_render_active_tab, intent_prefix="wiki", IM=IM, scope="user", empty={"tabs": {"home": {"id": "home", "path": "home.md", "label": "Home", "icon": "&#x1F3E0;", "order": 0}}, "active": "home"}, nesting_level=1)
    FM = BI.FileManager(WIKI_ROOT)
    IM.scripts["wiki_nav_link"] = [_intent_wiki_link]

    class _WikiEditor(BI.PortalEditor):
        def render_preview(self, content: str, **kwargs) -> str:
            path = kwargs.pop("path", "")
            base_dir = str(Path(path).parent) if path and Path(path).parent != Path(".") else ""
            def wikify(text):
                text = re.sub(r'!\[\[([^\]]+)\]\]', lambda m: _wiki_embed(m, base_dir), text)
                text = re.sub(r'\[\[([^\]]+)\]\]', lambda m: _wiki_link(m, base_dir), text)
                return text
            kwargs["post_escape_fn"] = wikify
            return super().render_preview(content, **kwargs)

        async def _im_settings(self, request, payload, imr):
            doc = await self._get_doc_from_state(request, payload)
            state = await wiki_state(request)
            did = doc["id"]; tab = state.get("tabs", {}).get(did)
            if tab:
                s = tab.setdefault("settings", {})
                for k in ("view","wrap","font","zoom","border","interactive"):
                    if k in payload: s[k] = payload[k]
                await wiki_state(request, state)
                doc["settings"] = s
            return imr.raw(self.render_shell(doc, include_css=False))

        async def _im_save(self, request, payload, imr):
            did = payload.get("branch", "default")
            state = await wiki_state(request)
            tab = state.get("tabs", {}).get(did)
            if not tab or not _can_edit(request, tab.get("path","")): return imr.raw('<span style="color:#ff5f5f;font-size:.7rem">&#x26A0; denied</span>')
            try:
                content = payload.get("content", "")
                self.fm.write(tab["path"], content)
                s = tab.get("settings", {})
                rendered = self.render_preview(content, zoom=s.get("zoom",1.0), task_interactive=s.get("interactive",False), doc_id=did, path=tab["path"], **self.render_kwargs_fn())
                imr.oob(rendered, f"editor-preview-{did}")
                return imr.raw('<span style="color:var(--accent);font-size:.7rem">&#x2713;</span>')
            except Exception as e:
                return imr.raw(f'<span style="color:#ff5f5f;font-size:.7rem">&#x26A0; {UI.escape(str(e))}</span>')    

    DE = _WikiEditor(base_url=_P, autosave_delay="2000ms", enable_graphviz=True, intent_prefix="wiki", IM=IM, nesting_level=1, file_manager=FM, get_tab=_wiki_get_tab, theme=env.get("theme", {}), render_kwargs_fn=lambda: {"loose_breaks": bool(SM.get("loose_breaks"))})
    print("[Wiki] ready")

# --- Rendering ---

async def _render_active_tab(request, state):
    active_id = state.get("active")
    if not active_id or active_id not in state.get("tabs", {}):
        state.setdefault("tabs", {})["home"] = {"id": "home", "path": "home.md", "label": "Home", "icon": "&#x1F3E0;", "order": 0}
        state["active"] = "home"
    tab = state["tabs"][state["active"]]
    return state, _render_document(tab.get("path") or "home.md", tab, request)

def _render_document(path: str, tab: dict, request: Request) -> str:
    if not _can_view(request, path): return '<div style="padding:1.5rem;color:#ff5f5f">Access denied for this page.</div>'
    try: p = resolve_path(path)
    except Exception as e: return f'<div style="padding:1.5rem;color:#ff5f5f">Resolve Error: {UI.escape(str(e))}</div>'
    if not p.exists(): return f'<div style="padding:1.5rem;color:#ff5f5f"><strong>File not found</strong><br>Requested path: {UI.escape(path)}</div>'
    ext = p.suffix.lower()
    if ext in (".png", ".jpg", ".jpeg", ".gif", ".webp", ".svg"): return f'<div style="height:100%;display:flex;align-items:center;justify-content:center;padding:1rem"><img src="{_P}/raw/{path}" style="max-width:100%;max-height:100%;object-fit:contain;border-radius:var(--radius)"></div>'
    if ext in (".svg"): return f'<div style="max-width:100%; max-height:100%; object-fit:contain;border-radius:var(--radius); height:100%; display:flex;align-items:center;justify-content:center; padding:1rem">{_P}/raw/{path}</div>'
    # if ext in (".json"): return UI.tree(items=p.json(), rel_to=WIKI_ROOT, mode="file", active=active_path, options={"post": "/im/in", "target": "body", "swap": "none", "extra_vals": {"type": "wiki_nav_link", "label": ""}}, context_menu_url=f"{_P}/ctx_menu", visible_fn=_visible)
    if ext == ".pdf": return f'<iframe src="{_P}/raw/{path}" style="width:100%;height:100%;border:none"></iframe>'
    # Else it goes to text read should work on .html(has a view mode), .txt, .yml, .log, .md and many others.
    try: content = p.read_text(encoding="utf-8")
    except Exception as e: return f'<div style="padding:1.5rem;color:#ff5f5f">Read error: {UI.escape(str(e))}</div>'
    if ext in (".py", ".sh", ".vbs", ".bat"): content = f'```{content}```'
    return DE.render_shell({"id": tab.get("id", f"wiki-{abs(hash(path)):06x}"), "title": p.name, "content": content, "path": path}, settings=tab.get("settings", {"view": "preview", "wrap": True}))

def _right_sidebar(active_path: str = "") -> str:
    info = ""
    if active_path and active_path != "home.md":
        try:
            p = resolve_path(active_path); st = p.stat()
            sz = f"{st.st_size//1024:.0f} KB" if st.st_size >= 1024 else f"{st.st_size} B"
            mt = datetime.fromtimestamp(st.st_mtime).strftime("%Y-%m-%d %H:%M")
            wc = len(p.read_text(encoding="utf-8", errors="ignore").split()) if p.suffix == ".md" else 0
            tags = ", ".join(_load_tags().get(active_path, [])) or "(none - right-click in tree to add)"
            info = f"""<div style="padding:.5rem .7rem; border-bottom:var(--border-thick) solid var(--border); flex-shrink:0">
                           <div style="margin-bottom:.3rem">File Info</div>
                           <div style="line-height:1.9; overflow-wrap:anywhere">
                               {UI.escape(active_path)}
                               <br>Size: {sz}{f"<br>Words: {wc:,}" if wc else ""}<br>Modified: {mt}<br>Tags: {UI.escape(tags)}
                           </div>
                       </div>"""
        except Exception: pass

    md_rows = [("**bold** *italic* ***both***", ""), ("~~strike~~ ==highlight==", ""),
               ("^super^ ~sub~", ""), ("# H1 to ###### H6", ""),
               ("![[file.png]]", "asset embed - image/video/pdf by extension, link fallback otherwise"),
               (":::details Title ... :::", "collapsible block"),
  #             ("<iframe>, <video>, etc.", "raw HTML passthrough - any tag works, not just these"),
               ("[label](url)  ![alt](url)", "links"), ("[[page]]  [[page\\|Display]]", "wiki link - 2nd form sets display text"),
               ("`code`  ```fenced```", "always shown literally, never interpreted"), ("- item  1. ordered", "lists"),
               ("- [x] done  - [ ] open", "tasks"), ("> blockquote", ""),
               ("| col | col |", "table"), ("[^id]  [^id]: text", "footnote"),
               ("Term\\n: Definition", "def list"), ("\\* \\_ \\` \\[ \\]", "escape a special character - shows it literally")]
    md_ref = "".join(f"""<div><code>{r}</code>{f" <span style='color:var(--text_muted);'>{h}</span>" if h else ""}</div>""" for r, h in md_rows)
    dot_ref = f"""<code style="white-space:pre; display:block">```dot\ndigraph G {{\n  rankdir=LR;\n  A [shape=box];\n  A -> B -> C;\n  node [style=filled];\n}}\n```</code>"""

    def _sec(label, body, open_=False):
        return f"""<details {"open" if open_ else ""} style="border-bottom:var(--border-thick) solid var(--border)">
                        <summary style="cursor:pointer; list-style:none; padding:.35rem .6rem; user-select:none">{label}</summary>
                        <div style="padding:.3rem .6rem .5rem;">{body}</div>
                    </details>"""
    return f"""<div style="display:flex; flex-direction:column; height:100%; overflow:hidden">{info}<div style="flex:1; overflow-y:auto">{_sec("Markdown Reference", md_ref, open_=True)}{_sec("Graphviz DOT", dot_ref)}</div></div>"""

# --- CSS / JS ---

CSS = """
.wiki-link { text-decoration: none; }
.wiki-link:hover { opacity: .8; }
.wiki-tree-row:hover .tree-ctx-btn { opacity: 1; }
"""

# --- Main route ---

@router.get("/", response_class=HTMLResponse)
async def index(request: Request):
    if not request.state.user: return RedirectResponse(url="/login")
    state = await wiki_state(request) 
    state, content = await _render_active_tab(request, state)
    tab_bar = await TM.tab_bar_fn(state, "wiki-tab-bar", "wiki", 1)
    wiki_title = (SM.get("title") or "Wiki") if SM else "Wiki"
    active_path = state.get("tabs", {}).get(state.get("active", ""), {}).get("path", "")
    left = f"""<div style="display:flex; flex-direction:column; height:100%; overflow:hidden">
                    <div style="padding:.35rem .5rem;border-bottom:var(--border-thick) solid var(--border); display:flex;align-items:center; gap:.3rem; flex-shrink:0; background:var(--bg_panel)">
                        <span style="font-size:.82rem;font-weight:600;flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{UI.escape(wiki_title)}</span>
                        <button class="btn-icon" style="font-size:.85rem" title="New file / folder / upload" hx-get="{_P}/new_modal" hx-target="#wiki-new-modal" hx-swap="innerHTML">&#x2795;</button>
                        <button class="btn-icon" style="font-size:.75rem" hx-get="{_P}/settings" hx-target="#wiki-workspace" hx-swap="innerHTML" title="Settings">&#x2699;</button>
                    </div>
                    <div id="wiki-tree-panel" style="flex:1; overflow-y:auto; font-size:.7rem;">{_wiki_tree_html(request, active_path)}</div>
                </div>"""
    right = f"""<div id="wiki-right-bar" style="height:100%;overflow:hidden">{_right_sidebar(active_path)}</div>"""
    return ENV["templates"].TemplateResponse(name="base.html", request=request, context={
        "request": request, "user": request.state.user, "nesting_level": 1, "extra_css": CSS + DE.CSS, "shell_id": IM.branch_id,
        "content": f"""<div id="wiki-workspace" style="height:100%;overflow:hidden">{content}</div><div id="wiki-new-modal"></div>""",
        "extra_script": ENV["tools"]["built_ins"].PORTAL_EDITOR_JS, "code_mirror": True,
        "toolbars": {"top": UI.toolbar(side="top", content=tab_bar, size="2.5rem", id="wiki-top", nesting_level=1, start_open=True, locked=True),
                     "left": UI.toolbar(side="left", content=left, size="18rem", id="wiki-left", nesting_level=1, start_open=False, resizable=True),
                     "right": UI.toolbar(side="right", content=right, size="18rem", id="wiki-right", nesting_level=1, start_open=False, resizable=True)}})

# --- Static / settings ---

@router.get("/raw/{path:path}")
async def serve_raw(request: Request, path: str):
    if not (request.state.user and _can_view(request, path)) and "public" not in _load_tags().get(path, []): raise HTTPException(403)
    p = resolve_path(path)
    if not p.exists(): raise HTTPException(404)
    return FileResponse(p)

@router.get("/settings", response_class=HTMLResponse)
async def settings_page(request: Request):
    g = SM.get_group("defaults")
    body = f"""<form hx-post="{_P}/settings/save" hx-target="#settings-status" style="display:flex;flex-direction:column;gap:.6rem">{g.render(g.load())}<button type="submit" class="button" style="margin-top:.5rem">Save</button><div id="settings-status" style="font-size:.75rem;min-height:1rem"></div></form>
    <div style="margin-top:1.5rem;padding-top:1rem;border-top:var(--border-thick) solid var(--border)"><button class="ui-btn" hx-get="{_P}/access" hx-target="#wiki-workspace" hx-swap="innerHTML">Per-Page Access Rules &#x2192;</button></div>"""
    return HTMLResponse(SM.page_shell(body, close_url=f"{_P}/close_settings", target_id="wiki-workspace"))

@router.post("/settings/save", response_class=HTMLResponse)
async def settings_save(request: Request):
    SM.get_group("defaults").save(dict(await request.form()))
    return HTMLResponse('<span style="color:var(--accent)">&#x2713; Saved</span>')

@router.get("/new_modal", response_class=HTMLResponse)
async def new_modal(request: Request):
    if not _can_edit(request): return HTMLResponse("Unauthorized", status_code=403)
    def cached_can_view(rel): return _can_view(request, rel)
    return HTMLResponse(BI.new_item_modal_html("wiki-new", f"{_P}/new", FM.folder_picker_html(filter_fn = lambda rel: cached_can_view(rel)), target_id="wiki-tree-panel", swap="innerHTML"))

@router.post("/new", response_class=HTMLResponse)
async def new_item(request: Request, parent: str = Form(""), kind: str = Form("file"), name: str = Form(""), upload: List[UploadFile] = File(None), rel_paths: str = Form("[]") ):
    if not _can_edit(request): return HTMLResponse("Unauthorized", status_code=403)
    base = resolve_path(parent)
    if kind in ["upload", "upload_folder"]:
        if upload:
            paths = json.loads(rel_paths)
            for file, path in zip(upload, paths):
                dest = base / path
                dest.parent.mkdir(parents=True, exist_ok=True)
                size = 0
                with dest.open("wb") as f:
                    while chunk := await file.read(65536):
                        size += len(chunk)
                        if size > MAX_UPLOAD_BYTES: raise HTTPException(status_code=413, detail=f"{path} exceeds {MAX_UPLOAD_BYTES//1024//1024}MB limit")
                        f.write(chunk)
    elif kind == "folder":
        if name.strip(): (base / name.strip()).mkdir(parents=True, exist_ok=True)
    else:
        if name.strip():
            target = base / name.strip()
            if not target.suffix: target = target.with_suffix(".md")
            target.parent.mkdir(parents=True, exist_ok=True)
            if not target.exists(): target.write_text("", encoding="utf-8")
    FM.notify_manual_mutation([str(dest.resolve()) for dest in written_paths], "created")
    return HTMLResponse(_wiki_tree_html(request))

@router.get("/ctx_menu", response_class=HTMLResponse)
async def ctx_menu(request: Request, path: str):
    if not _can_edit(request, path): return HTMLResponse("")
    tags = ",".join(_load_tags().get(path, []))
    return HTMLResponse(f"""<div style="padding:.3rem .5rem;display:flex;flex-direction:column;gap:.25rem;font-size:.75rem">
        <form hx-post="{_P}/tags/set" hx-target="this" hx-swap="outerHTML" style="display:flex;gap:.3rem">
            <input type="hidden" name="path" value="{UI.escape(path)}">
            <input type="text" name="tags" value="{UI.escape(tags)}" placeholder="tags, comma-sep" class="module-select" style="font-size:.7rem;flex:1">
            <button class="btn-icon" style="font-size:.7rem">&#x2713;</button>
        </form>
        <button class="btn-icon" style="text-align:left" hx-post="{_P}/duplicate" hx-vals='{{"path":"{UI.escape(path)}"}}' hx-target="#wiki-tree-panel" hx-swap="innerHTML">&#x2398; Duplicate</button>
        <button class="btn-icon" style="text-align:left" hx-get="{_P}/move_modal?path={urllib.parse.quote(path)}" hx-target="#wiki-new-modal" hx-swap="innerHTML">&#x21C4; Move</button>
        <button class="btn-icon" style="text-align:left;color:#ff5f5f" hx-get="{_P}/delete_confirm?path={urllib.parse.quote(path)}" hx-target="#wiki-new-modal" hx-swap="innerHTML">&#x2715; Delete</button>
    </div>""")

@router.post("/tags/set", response_class=HTMLResponse)
async def tags_set(request: Request, path: str = Form(...), tags: str = Form("")):
    if not _can_edit(request, path): return HTMLResponse("Unauthorized", status_code=403)
    t = _load_tags(); t[path] = [x.strip() for x in tags.split(",") if x.strip()]
    _save_tags(t)
    return HTMLResponse('<span style="color:var(--accent);font-size:.7rem">&#x2713; saved</span>')

@router.get("/move_modal", response_class=HTMLResponse)
async def move_modal(request: Request, path: str):
    if not _can_edit(request, path): return HTMLResponse("Unauthorized", status_code=403)
    return HTMLResponse(BI.move_modal_html("wiki-move", f"{_P}/move", FM.folder_picker_html(), path, target_id="wiki-tree-panel", swap="innerHTML"))

@router.post("/move", response_class=HTMLResponse)
async def move_item(request: Request, path: str = Form(...), parent: str = Form("")):
    if not _can_edit(request, path): return HTMLResponse("Unauthorized", status_code=403)
    FM.move(path, parent)
    return HTMLResponse(_wiki_tree_html(request))

@router.post("/delete", response_class=HTMLResponse)
async def delete_item(request: Request, path: str = Form(...)):
    if not _can_edit(request, path): return HTMLResponse("Unauthorized", status_code=403)
    p = resolve_path(path)
    if p.exists(): shutil.rmtree(p) if p.is_dir() else p.unlink()
    return HTMLResponse(_wiki_tree_html(request))

@router.get("/close_settings", response_class=HTMLResponse)
async def close_settings(request: Request): return HTMLResponse(await TM.render_active(request))

def _access_rows_html() -> str:
    rules = _load_rules()
    rows = "".join(f"""<tr><td>{r["target_type"]}</td><td style="font-family:var(--font-mono);font-size:.72rem">{UI.escape(r["target"])}</td><td>{r["scope"]}</td><td>{r["mode"]}</td><td style="font-size:.72rem">{", ".join(r.get("subjects",[]))}</td><td><button class="btn-icon" style="color:#ff5f5f" hx-delete="{_P}/access/{r["id"]}" hx-target="#wiki-access-rows" hx-swap="outerHTML">&#x2715;</button></td></tr>""" for r in rules) or '<tr><td colspan="6" style="color:var(--text_muted);font-size:.8rem">No rules - all pages follow the global edit/view roles.</td></tr>'
    return f'<tbody id="wiki-access-rows">{rows}</tbody>'

@router.get("/access", response_class=HTMLResponse)
async def access_rules_page(request: Request):
    if not _can_edit(request): return HTMLResponse("Unauthorized", status_code=403)
    body = f"""<p style="font-size:.78rem;color:var(--text_muted)">Rules narrow access beyond the global Edit/View roles in Wiki Settings. Target a folder/file path (prefix match) or a tag (set via a page's context menu). Whitelist = only listed subjects may access; blacklist = listed subjects are denied. Subjects: username or role:&lt;role&gt;.</p>
        <form hx-post="{_P}/access/add" hx-target="#wiki-access-rows" hx-swap="outerHTML" style="display:flex;gap:.4rem;flex-wrap:wrap;margin-bottom:1rem;align-items:flex-end">
            <label style="font-size:.72rem;color:var(--text_muted)">Type<select name="target_type" class="module-select" style="margin:0"><option value="path">Path</option><option value="tag">Tag</option></select></label>
            <label style="font-size:.72rem;color:var(--text_muted)">Target<input type="text" name="target" class="module-select" style="margin:0" placeholder="folder/ or page.md or tagname" required></label>
            <label style="font-size:.72rem;color:var(--text_muted)">Scope<select name="scope" class="module-select" style="margin:0"><option value="edit">Edit</option><option value="view">View</option></select></label>
            <label style="font-size:.72rem;color:var(--text_muted)">Mode<select name="mode" class="module-select" style="margin:0"><option value="whitelist">Whitelist</option><option value="blacklist">Blacklist</option></select></label>
            <label style="font-size:.72rem;color:var(--text_muted)">Subjects<input type="text" name="subjects" class="module-select" style="margin:0" placeholder="alice, role:moderator" required></label>
            <button type="submit" class="ui-btn">Add Rule</button>
        </form>
        <table style="width:100%;border-collapse:collapse;font-size:.8rem"><thead><tr style="color:var(--text_muted);border-bottom:var(--border-thick) solid var(--border)"><th>Type</th><th>Target</th><th>Scope</th><th>Mode</th><th>Subjects</th><th></th></tr></thead>{_access_rows_html()}</table>"""
    return HTMLResponse(SM.page_shell(body, close_url=f"{_P}/close_settings", target_id="wiki-workspace", title="Per-Page Access Rules"))

@router.post("/access/add", response_class=HTMLResponse)
async def access_add(request: Request, target_type: str = Form(...), target: str = Form(...), scope: str = Form(...), mode: str = Form(...), subjects: str = Form(...)):
    if not _can_edit(request): return HTMLResponse("Unauthorized", status_code=403)
    rules = _load_rules()
    rules.append({"id": f"r_{uuid.uuid4().hex[:8]}", "target_type": target_type, "target": target.strip(), "scope": scope, "mode": mode, "subjects": [s.strip() for s in subjects.split(",") if s.strip()]})
    _save_rules(rules)
    return HTMLResponse(_access_rows_html())

@router.delete("/access/{rule_id}", response_class=HTMLResponse)
async def access_delete(rule_id: str, request: Request):
    if not _can_edit(request): return HTMLResponse("Unauthorized", status_code=403)
    _save_rules([r for r in _load_rules() if r["id"] != rule_id])
    return HTMLResponse(_access_rows_html())

@router.post("/duplicate", response_class=HTMLResponse)
async def duplicate_item(request: Request, path: str = Form(...)):
    if not _can_edit(request, path): return HTMLResponse("Unauthorized", status_code=403)
    p = resolve_path(path)
    if not p.exists() or p.is_dir(): return HTMLResponse(_wiki_tree_html(request))
    stem, suffix, n, dest = p.stem, p.suffix, 1, p.with_name(f"{p.stem} (copy){p.suffix}")
    while dest.exists(): n += 1; dest = p.with_name(f"{stem} (copy {n}){suffix}")
    dest.write_bytes(p.read_bytes())
    return HTMLResponse(_wiki_tree_html(request))

@router.get("/delete_confirm", response_class=HTMLResponse)
async def delete_confirm(request: Request, path: str):
    if not _can_edit(request, path): return HTMLResponse("Unauthorized", status_code=403)
    p = resolve_path(path)
    count = sum(1 for _ in p.rglob("*") if _.is_file()) if p.is_dir() else 1
    warn = f"This folder contains {count} file(s). Deleting it removes everything inside, permanently." if p.is_dir() else "This file will be deleted permanently."
    body = f"""<div style="font-size:.85rem">{warn}</div><div style="display:flex;gap:.5rem;margin-top:1rem">
        <button class="ui-btn" style="color:#ff5f5f" hx-post="{_P}/delete" hx-vals='{{"path":"{UI.escape(path)}"}}' hx-target="#wiki-tree-panel" hx-swap="innerHTML" onclick="UI_closeModal('wiki-delete')">Delete</button>
        <button class="ui-btn" onclick="UI_closeModal('wiki-delete')">Cancel</button>
    </div>"""
    return HTMLResponse(UI.modal("wiki-delete", f"Confirm delete: {Path(path).name}", body))
